PORT=4000

# MySQL connection. Create an empty database first (e.g. "mealmind" in phpMyAdmin,
# collation utf8mb4_unicode_ci); the server creates all tables on start.
DATABASE_URL=mysql://root:your-mysql-password@localhost:3306/mealmind
# XAMPP/WAMP default root user without a password:
# DATABASE_URL=mysql://root@localhost:3306/mealmind
#
# Or, instead of DATABASE_URL (handy when the password contains @ # / or spaces):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your-mysql-password
# DB_NAME=mealmind

# Set to false if you prefer to create/update tables yourself with `npm run db:migrate`.
# DB_AUTO_MIGRATE=true

JWT_SECRET=change-me
GEMINI_API_KEY=your-key-from-aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash
# Optional credentials used only by `npm run seed:admin`; seeding is never automatic.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
